# Copy to deploy/test.env; never commit that file.
# Use hex/URL-safe values: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DJANGO_SECRET_KEY=replace-with-a-different-random-secret
TEST_BIND=127.0.0.1
TEST_PORT=8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SEED_DEMO=1
# For the HTTPS hosting override:
# SITE_DOMAIN=atom-test.example.com
# Optional real email; otherwise email is printed in worker logs:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-account
# EMAIL_HOST_PASSWORD=your-secret
# DEFAULT_FROM_EMAIL=alerts@example.com
